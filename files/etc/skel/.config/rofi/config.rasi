/* =============================================================
   Rofi Config — Tema Omarchy / Tokyo Night
   ============================================================= */

configuration {
    modi: "drun,run,window";
    lines: 8;
    font: "JetBrainsMono Nerd Font 12";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    terminal: "ghostty";
    drun-display-format: "{icon} {name}";
    location: 0;
    disable-history: false;
    hide-scrollbar: true;
    display-drun: "   Buscar aplicativos: ";
    display-run: "   Executar: ";
    display-window: "   Janelas: ";
}

@theme "/dev/null"

* {
    bg-col:  #1a1b26;
    bg-col-light: #24283b;
    border-col: #7aa2f7;
    selected-col: #2ac3de;
    blue: #7aa2f7;
    fg-col: #c0caf5;
    fg-col2: #565f89;
    grey: #414868;

    width: 600;
    font: "JetBrainsMono Nerd Font 12";
}

element-text, element-icon , mode-switcher {
    background-color: inherit;
    text-color:       inherit;
}

window {
    height: 420px;
    border: 2px;
    border-color: @border-col;
    border-radius: 12px;
    background-color: @bg-col;
    padding: 15px;
}

mainbox {
    background-color: @bg-col;
}

inputbar {
    children: [prompt,entry];
    background-color: @bg-col-light;
    border-radius: 8px;
    padding: 4px;
    margin: 0px 0px 10px 0px;
}

prompt {
    background-color: @blue;
    padding: 6px 12px;
    text-color: @bg-col;
    border-radius: 6px;
    margin: 4px;
}

textbox-prompt-colon {
    expand: false;
    str: ":";
}

entry {
    padding: 8px;
    margin: 4px 0px 0px 10px;
    text-color: @fg-col;
    background-color: transparent;
    placeholder: "Digite para filtrar...";
    placeholder-color: @fg-col2;
}

listview {
    border: 0px;
    padding: 6px 0px 0px;
    margin: 10px 0px 0px 20px;
    columns: 1;
    lines: 7;
    background-color: @bg-col;
}

element {
    padding: 8px 12px;
    background-color: @bg-col;
    text-color: @fg-col;
    border-radius: 8px;
}

element-icon {
    size: 24px;
    margin: 0px 10px 0px 0px;
}

element selected {
    background-color:  @bg-col-light;
    text-color: @blue;
}

mode-switcher {
    spacing: 0;
}

button {
    padding: 10px;
    background-color: @bg-col-light;
    text-color: @grey;
    vertical-align: 0.5;
    horizontal-align: 0.5;
}

button selected {
    background-color: @bg-col;
    text-color: @blue;
}
